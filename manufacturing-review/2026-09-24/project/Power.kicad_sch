	(text "Nominal board limit 1.49 A (8.06k); normal operating target <=1.2 A total.\nAdapter: regulated 12 V / 3 A, isolated and current-limited.\nAuxiliary output shares the protected budget; no daisy-chain guarantee.\nFuses are secondary protection; fault clearing and hot-start tests required."
		(exclude_from_sim no)
		(at 15 263 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "9ccaba6a-4cae-582f-a208-1c1d8f6d91a8")
	)
	(text "APPROVED POC MODULE POWER\nBoth converters fed from protected 12V_SW.\n2 A output nameplate each; combined input budget applies.\n17.5 mm module height; enclosure clearance required.\nInput/output capacitors still need sourcing/qualification."
		(exclude_from_sim no)
		(at 300 35 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "a4ad7e9a-cbee-5fdb-9e75-a7e33f039fd5")
	)
	(text "12 VDC INPUT PROTECTION\nLOW-VOLTAGE POC - NOT RELEASED"
		(exclude_from_sim no)
		(at 300 15 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "cd179f10-0a1a-567c-a9f4-509d2428bf9d")
	)
	(text "RTN island and exposed pad are separate from system GND.\nUVLO ~8.91 V; OVP ~15.95 V, nominal. Divider tolerance applies.\nMODE to RTN: current limit / auto-retry.\n100 nF dVdT: ~9.6 ms at 12 V (nominal).\nTP_IMON / TP_FLT reference EF_RTN; not MCU logic signals."
		(exclude_from_sim no)
		(at 295 155 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "dd21e18c-8b72-5a35-8e04-0d17e2a857d2")
	)
	(text "SETTINGS / FLOATING RETURN: EF_RTN MUST NOT CONNECT TO GND"
