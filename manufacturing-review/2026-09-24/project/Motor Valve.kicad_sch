	(text "12 V controller supply powers relay coils only. External isolated 24 VAC valve supply is NOT connected to controller rails.\nWire each valve using COM and NO. Provide external branch fusing and AC-compatible coil suppression.\nPOC target: Hunter PGV-101-G-B, eight simultaneous valves for qualification. Contact/load life testing required."
		(exclude_from_sim no)
		(at 20 116 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "162d198a-ebd0-55a5-9c15-c49cff7a6441")
	)
	(text "GPA0..7 = channels 1..8, active high. GPB and interrupts unused.\n47k input pull-downs: relay commands off while expander pins are inputs.\nFirmware: write OLATA=0 before IODIRA=0; default concurrency=1.\nMCU software reset alone does NOT force expander reset."
		(exclude_from_sim no)
		(at 225 82 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "4ce61139-286a-527d-bd9b-69a70376fbc7")
	)
	(text "EIGHT INDEPENDENT LOW-VOLTAGE DRY CONTACTS - NO MAINS"
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "a00924e6-3ac4-50aa-bbd0-372435367ac5")
	)
